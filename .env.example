# TasteTrail Environment Configuration Example
# Copy this file to .env for local development

# Server Port
PORT=5000

# SQLite Database File Path (defaults to backend/data/tastetrail.db)
DATABASE_PATH=backend/data/tastetrail.db

# JWT Secret for Session Authentication (replace with strong secret in production)
JWT_SECRET=tastetrail-development-session-secret-key-change-in-production

# Node Environment
NODE_ENV=development
